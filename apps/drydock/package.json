{
  "name": "drydock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Conductor, for machines in the cloud. A project is one Fountain agent, environment and vault; a thread is a conversation on an ephemeral machine of its own, with a real terminal over Sprites. Sign in with GitHub; the server owns the Fountain account.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "mock": "bun mock/server.ts",
    "server": "STATIC_DIR= DATA_DIR=./data bun --watch server/index.ts",
    "start": "bun server/index.ts"
  },
  "dependencies": {
    "@managoat/fountain-app": "workspace:*",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
