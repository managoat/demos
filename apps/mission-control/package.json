{
  "name": "mission-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One goal, a fleet of agents: describe a mission, approve the coordinator's plan, and watch one sandboxed agent per task work it \u2014 one synthesized report at the end. Talks only to the Fountain API.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "mock": "bun mock/server.ts"
  },
  "dependencies": {
    "@managoat/fountain-app": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
